MLR_tidy_lasso = lasso_inference_df %>%
# This step maps "priorfracYes" to the variable "priorfrac" using your data
tidy_identify_variables(data = glow_train) %>%
# This adds the human-readable labels (e.g., "Prior Fracture")
tidy_add_term_labels() %>%
# This adds the "Reference" rows for factors
tidy_add_reference_rows() %>%
# Now we exponentiate to get Odds Ratios
tidy_estimate_to_reference_rows(exponentiate = TRUE) %>%
# Final step: calculate ORs for the rest of the rows
mutate(
across(c(estimate, conf.low, conf.high), ~exp(.x))
)
