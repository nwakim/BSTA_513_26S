library(tidyverse)
#library(textrecipes)
library(here)
library(aplore3)
library(regressinator)
library(ggplot2)
library(broom)
library(gt)
library(gtsummary)
theme_set(theme_minimal())
mean_age = mean(glow500$age) %>% round()
glow1 = glow500 %>% mutate(age_c = age - mean_age)
load(here("lessons", "12_Assessing_fit/data", "glow_results.Rda"))
source(here("lessons", "13_Model_diagnostics", "Logistic_Dx_Functions.R"))
# Chunk 3
# 1. Augment model for residuals and leverage
glow_dx <- augment(glow_m3, type.predict = "response", type.residuals = "deviance") %>%
mutate(
index = row_number(),
.std.resid = .resid / sqrt(1 - .hat),
cooksd = cooks.distance(glow_m3),
dffits = dffits(glow_m3)
)
# 2. Get DFBETAs separately
dfb <- as.data.frame(dfbetas(glow_m3))
colnames(dfb) <- paste0("dfb_", colnames(dfb))
glow_dx <- cbind(glow_dx, dfb)
# Chunk 4
#| code-fold: true
ggplot(glow_dx, aes(x = .fitted, y = .std.resid)) +
geom_point(alpha = 0.5) +
geom_hline(yintercept = c(-3, 3), col = "red", linetype = "dashed") +
labs(x = "Predicted Probability", y = "Std. Deviance Residual")
glow_dx %>% filter(cooksd > 4/500) %>%
select(priorfrac, age, .fitted, cooksd) %>% head(3)
# Augment for residuals
aug_glow = augment(glow_m3, type.predict = "response", type.residuals = "deviance")
# Calculate influence measures (Cook's D, DFFITS, DFBETAs)
infl = influence.measures(glow_m3)
glow_dx = cbind(aug_glow, as.data.frame(infl$infmat)) %>%
rename(std.dev.res = .std.resid) %>%
select(-.cooksd)
glow_dx = cbind(aug_glow, as.data.frame(infl$infmat)) %>%
rename(std.dev.res = .std.resid)
glimpse(dx_glow)
