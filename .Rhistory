library(mlbench)
library(tidyverse)
library(gtsummary)
library(expss)
data(PimaIndiansDiabetes)
pima2 = PimaIndiansDiabetes %>%
mutate(diabetes = as.factor(diabetes) %>% relevel(ref = "neg"),
preg = case_match(pregnant,
0:5 ~ "0-5",
6:10 ~ "6-10",
11:17 ~ "10+") %>%
factor(levels = c("0-5", "6-10", "10+")))
pima2 = apply_labels(pima2, preg = "Number of Pregnancies")
mod = glm(diabetes ~ preg, data = pima2, family = binomial)
summary(mod)
tbl_regression(mod, exponentiate = T)
