mutate(
Underfit = augment(lm_fit$fit) %>% dplyr::select(.fitted) %>% pull(),
OK       = augment(loess_fit) %>% dplyr::select(.fitted) %>% pull(),
Overfit  = augment(loess_overfit) %>% dplyr::select(.fitted) %>% pull(),
) %>%
pivot_longer(
cols      = Underfit:Overfit,
names_to  = "fit",
values_to = "y_hat"
) %>%
