tab_options(table.font.size = 38)
# Chunk 14
newdata = data.frame(x = c(1, 2, 3))
pred = predict(ex1_cont_glm, newdata, se.fit=T, type = "link")
LL_CI1 = pred$fit - qnorm(1-0.05/2) * pred$se.fit
UL_CI1 = pred$fit + qnorm(1-0.05/2) * pred$se.fit
pred_link = data.frame(x = newdata, Pred = pred$fit, LL_CI1, UL_CI1)
# Chunk 15
#| out-width: 100%
#| fig-width: 4
#| fig-height: 2.5
#| code-fold: true
#| code-summary: Plotting fitted log-odds
ggplot() +
labs(y = "Log-odds of Outcome") +
scale_fill_manual(values=c("#D6295E", "#ED7D31")) +
geom_point(data = pred_link, aes(x = x, y=Pred), size=3) +
geom_errorbar(data = pred_link, aes(x = x, y=Pred, ymin = LL_CI1, ymax = UL_CI1), width = 0.25)
# Chunk 16
newdata = data.frame(x = c(1, 2, 3))
pred = predict(ex1_cont_glm, newdata, se.fit=T, type = "link")
LL_CI1 = pred$fit - qnorm(1-0.05/2) * pred$se.fit
UL_CI1 = pred$fit + qnorm(1-0.05/2) * pred$se.fit
pred_link = cbind(Pred = pred$fit, LL_CI1, UL_CI1) %>% inv.logit()
pred_prob = as.data.frame(pred_link) %>% mutate(x = c("One", "Two", "Three"))
# Chunk 17
#| out-width: 100%
#| fig-width: 4
#| fig-height: 2.5
#| code-fold: true
