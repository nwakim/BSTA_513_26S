library(mctest)
library(kableExtra)
load(here("data", "bc_diagnosis.Rda"))
mean_age = mean(bc$Age)
bc = bc %>% mutate(Late_stage_num = as.numeric(Late_stage_diag)-1,
Age_c = Age - mean(Age))
# Chunk 3
#| echo: false
