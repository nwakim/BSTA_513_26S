cbind(outcome = rep(0, 21), x = c(rep("One", 13), rep("Two", 8))))) %>%
mutate(outcome = as.factor(outcome) %>% relevel(ref = "0"),
x = factor(x, levels = c("One", "Two", "Three")))
# Chunk 4
ex1_m = glm(outcome ~ x, data = ex1,
family = binomial)
# Chunk 5
