library(mlbench)
library(tidyverse)
library(gtsummary)
library(expss)
library(broom)
data(PimaIndiansDiabetes)
pima2 = PimaIndiansDiabetes %>%
mutate(diabetes = as.factor(diabetes) %>% relevel(ref = "neg"),
preg = case_match(pregnant,
0:5 ~ "0-5",
6:10 ~ "6-10",
11:17 ~ "10+") %>%
factor(levels = c("0-5", "6-10", "10+")))
pima2 = apply_labels(pima2,
preg = "Number of Pregnancies",
age = "Age (years)")
mod_main = glm(diabetes ~ preg + age, data = pima2, family = binomial)
tbl_regression(mod_main, exponentiate = T)
mod_main = glm(diabetes ~ preg + age, data = pima2, family = binomial)
mod_int = glm(diabetes ~ preg*age, data = pima2, family = binomial)
tbl_regression(mod_int, estimate_fun = ~ style_number(.x, digits = 4))
lmtest::lrtest(mod_main, mod_int)
summary(mod_int)
tbl_regression(mod_int, estimate_fun = ~ style_number(.x, digits = 4))
newdata = data.frame(preg = "6-10", age = 47)
newdata = data.frame(preg = "6-10", age = 47)
prediction = predict(mod_main, newdata, type = "response")
prediction
