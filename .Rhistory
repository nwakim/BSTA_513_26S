ggplot(                          # <1>
data = MLR_tidy0,              # <2>
aes(                           # <3>
y=label,                      # <4>
x=estimate,           # <5>
xmin=conf.low,        # <6>
xmax=conf.high        # <7>
)                     # <3>
) +                      # <1>
geom_point(   # <8>
size = 2
) +  # <8>
geom_errorbarh(         # <9>
width = 0.2
) + # <9>
geom_vline(             # <10>
xintercept=1,         # <11>
color='#C2352F',       # <12>
linetype='dashed',    # <13>
) +                    # <10>
facet_grid(                 # <14>
rows = vars(var_label),     # <15>
scales = "free",          # <16>
space='free_y',            # <17>
switch = "y"               # <18>
) +                        # <14>
labs(                       # <19>
x = "OR (95% CI)",         # <20>
title = "Odds ratios of food insecurity",  # <21>
y = element_blank()  # <22>
) + # <19>
theme_classic() + # <23>
theme(   # <24>
axis.title = element_text(size = 14), # <25>
axis.text = element_text(size = 14), # <26>
title = element_text(size = 14), # <27>
strip.placement = "outside",  # <28>
strip.text.y.left = element_text(size = 14, angle = 0),  # <29>
strip.background = element_blank() # <30>
) # <24>
MLR_tidy0 =
tidy_and_attach(                                   # <1>
model,                                           # <1>
conf.int=T,                                      # <1>
exponentiate = T                                 # <1>
) %>%                                            # <1>
tidy_remove_intercept() %>%                        # <2>
tidy_add_reference_rows() %>%                      # <3>
tidy_add_estimate_to_reference_rows() %>%          # <4>
tidy_add_term_labels() %>%                         # <5>
mutate(
var_label = case_match(                          # <6>
var_label,
"PPINCIMP" ~ "Annual\nhousehold\nincome",      # <7>
"XACSNET"  ~ "Internet\naccess",               # <7>
"FAMSIZE"  ~ "Family\nsize",                   # <7>
"PPEDUCAT" ~ "Education\nlevel",                # <7>
"PPAGE_10" ~ ""
)
) %>%
mutate( # <8>
label = fct_rev(
fct_inorder(label)
)
)     # <8>
